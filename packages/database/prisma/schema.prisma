  details         Json?
  createdByUserId String?        @map("created_by_user_id")
  revenueModel    String         @default("RPA") @map("revenue_model")
  payoutModel     String         @default("CPA") @map("payout_model")
  payoutType      String         @default("FLAT") @map("payout_type")
  revenue         Decimal        @db.Decimal(10, 2)
  payout          Decimal        @db.Decimal(10, 2)
  status          CpaOfferStatus @default(PAUSED)
  postbackToken   String         @unique @map("postback_token")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  conversions     CpaOfferConversion[]
  clicks          CpaOfferClick[]
  cpaEarnings     CpaEarning[]
  optinPages      AdvertiserOptinPage[]
  createdBy       User?          @relation("CpaOfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([network])
  @@index([category])
  @@index([createdByUserId])
  @@map("cpa_offers")
}

model CpaOfferClick {
  id           String   @id @default(cuid())
  offerId      String   @map("offer_id")
  advertiserId String   @map("advertiser_id")
  leadId       String?  @map("lead_id")
  subId        String?  @map("sub_id")
  src          String?
  ip           String?
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  offer        CpaOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  advertiser   User     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversions  CpaOfferConversion[]

  @@index([offerId, createdAt])
  @@index([advertiserId])
  @@index([leadId])
  @@map("cpa_offer_clicks")
}

model CpaOfferConversion {
  id            String   @id @default(cuid())
  offerId       String   @map("offer_id")
  clickId       String?  @map("click_id")
  advertiserId  String?  @map("advertiser_id")
  clickRecordId String?  @map("click_record_id")
  payout        Decimal? @db.Decimal(10, 2)
  rawQuery      Json?    @map("raw_query")
  createdAt     DateTime @default(now()) @map("created_at")
  offer         CpaOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  advertiser    User?    @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  clickRecord   CpaOfferClick? @relation(fields: [clickRecordId], references: [id], onDelete: SetNull)
  deliveries    CpaPostbackDelivery[]
  cpaEarning    CpaEarning?

  @@index([offerId, createdAt])
  @@index([advertiserId, createdAt])
  @@index([clickRecordId])
  @@map("cpa_offer_conversions")
}

model CpaWallet {
  id           String   @id @default(cuid())
  advertiserId String   @unique @map("advertiser_id")
  balance      Decimal  @default(0) @db.Decimal(12, 2)
  holdBalance  Decimal  @default(0) @db.Decimal(12, 2) @map("hold_balance")
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  advertiser User @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@map("cpa_wallets")
}

model EmailWallet {
  id           String   @id @default(cuid())
  advertiserId String   @unique @map("advertiser_id")
  balance      Decimal  @default(0) @db.Decimal(12, 4)
  currency     String   @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  advertiser User               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  entries    EmailWalletLedger[]

  @@map("email_wallets")
}

model EmailWalletLedger {
  id            String          @id @default(cuid())
  walletId      String          @map("wallet_id")
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 4)
  balanceAfter  Decimal         @db.Decimal(12, 4) @map("balance_after")
  referenceType String          @map("reference_type")
  referenceId   String?         @map("reference_id")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")

  wallet EmailWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("email_wallet_ledger")
}

model CpaEarning {
  id           String           @id @default(cuid())
  advertiserId String           @map("advertiser_id")
  conversionId String           @unique @map("conversion_id")
  offerId      String           @map("offer_id")
  amount       Decimal          @db.Decimal(10, 2)
  availableAt  DateTime         @map("available_at")
  status       CpaEarningStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")

  advertiser User               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  conversion CpaOfferConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  offer      CpaOffer           @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([advertiserId, createdAt])
  @@index([advertiserId, status, availableAt])
  @@map("cpa_earnings")
}

model AdvertiserGlobalPostback {
  id           String               @id @default(cuid())
  advertiserId String               @unique @map("advertiser_id")
  type         GlobalPostbackType   @default(S2S)
  status       GlobalPostbackStatus @default(INACTIVE)
  endpoint     String               @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  advertiser   User                 @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@map("advertiser_global_postbacks")
}

model CpaPostbackDelivery {
  id           String                     @id @default(cuid())
  conversionId String                     @map("conversion_id")
  target       CpaPostbackDeliveryTarget
  url          String                     @db.Text
  status       CpaPostbackDeliveryStatus  @default(PENDING)
  httpStatus   Int?                       @map("http_status")
  error        String?                    @db.Text
  attempts     Int                        @default(0)
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  conversion   CpaOfferConversion         @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@unique([conversionId, target])
  @@index([conversionId])
  @@index([status, createdAt])
  @@map("cpa_postback_deliveries")
}

enum CatalogCategoryStatus {
  ACTIVE
  INACTIVE
}

enum DigitalProductStatus {
  ACTIVE
  DRAFT
}

enum GetPaidTaskStatus {
  ACTIVE
  DRAFT
  PAUSED
}

enum PublisherAnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum AnnouncementAudience {
  ADVERTISER
  PUBLISHER
  BOTH
}

enum AnnouncementTone {
  VIOLET
  EMERALD
  BLUE
  AMBER
}

enum PublisherTaskSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model DigitalProductCategory {
  id        String                @id @default(cuid())
  name      String                @unique
  status    CatalogCategoryStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  products  DigitalProduct[]

  @@map("digital_product_categories")
}

model DigitalProduct {
  id                    String               @id @default(cuid())
  name                  String
  categoryId            String               @map("category_id")
  shortDescription      String               @map("short_description") @db.Text
  productType           String               @map("product_type")
  niche                 String
  status                DigitalProductStatus @default(DRAFT)
  featured              Boolean              @default(false)
  isNew                 Boolean              @default(false) @map("is_new")
  salesPageUrl          String?              @map("sales_page_url") @db.Text
  affiliateTrackingParam String?             @map("affiliate_tracking_param")
  previewUrl            String?              @map("preview_url") @db.Text
  frontEndCommission    Decimal              @map("front_end_commission") @db.Decimal(5, 2)
  upsellCommission      Decimal?             @map("upsell_commission") @db.Decimal(5, 2)
  referralReward        Decimal?             @map("referral_reward") @db.Decimal(10, 2)
  price                 Decimal              @db.Decimal(10, 2)
  vendor                String?
  webhookSecret         String?              @map("webhook_secret")
  imageUrl              String?              @map("image_url") @db.Text
  thumbTone             String?              @map("thumb_tone")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  category              DigitalProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@map("digital_products")
}

model GetPaidTaskCategory {
  id        String                @id @default(cuid())
  name      String                @unique
  status    CatalogCategoryStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  tasks     GetPaidTask[]

  @@map("get_paid_task_categories")
}

model GetPaidTask {
  id                     String            @id @default(cuid())
  title                  String
  categoryId             String            @map("category_id")
  descriptionHtml        String            @map("description_html") @db.Text
  descriptionText        String            @map("description_text") @db.Text
  taskType               String            @map("task_type")
  requiredAction         String            @map("required_action")
  requiredLink           String?           @map("required_link") @db.Text
  additionalInstructions String?           @map("additional_instructions") @db.Text
  rewardAmount           Decimal           @map("reward_amount") @db.Decimal(10, 2)
  dailyLimit             Int?              @map("daily_limit")
  totalLimit             Int?              @map("total_limit")
  proofRequired          Boolean           @default(true) @map("proof_required")
  deductPoints           Boolean           @default(false) @map("deduct_points")
  disallowedCountries    Json?             @map("disallowed_countries")
  status                 GetPaidTaskStatus @default(DRAFT)
  showOnDashboard        Boolean           @default(false) @map("show_on_dashboard")
  featured               Boolean           @default(false)
  isNew                  Boolean           @default(false) @map("is_new")
  startDate              DateTime?         @map("start_date")
  endDate                DateTime?         @map("end_date")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  category               GetPaidTaskCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  submissions            PublisherTaskSubmission[]

  @@index([status])
  @@index([categoryId])
  @@index([showOnDashboard])
  @@map("get_paid_tasks")
}

model PublisherAnnouncement {
  id          String                      @id @default(cuid())
  title       String
  body        String                      @db.Text
  iconKey     String?                     @map("icon_key")
  audience    AnnouncementAudience        @default(PUBLISHER)
  tone        AnnouncementTone            @default(BLUE)
  status      PublisherAnnouncementStatus @default(DRAFT)
  publishedAt DateTime?                   @map("published_at")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([status, audience, publishedAt])
  @@map("publisher_announcements")
}

model PublisherTaskSubmission {
  id           String                      @id @default(cuid())
  publisherId  String                      @map("publisher_id")
  taskId       String                      @map("task_id")
  status       PublisherTaskSubmissionStatus @default(PENDING)
  rewardAmount Decimal                     @map("reward_amount") @db.Decimal(10, 2)
  proofUrl     String?                     @map("proof_url") @db.Text
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  publisher    User                        @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  task         GetPaidTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([publisherId, status])
  @@index([taskId])
  @@map("publisher_task_submissions")
}

model Promotion {
  id           String   @id @default(cuid())
  name         String
  utmSource    String   @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  utmCampaign  String   @map("utm_campaign")
  utmContent   String?  @map("utm_content")
  utmTerm      String?  @map("utm_term")
  landingPath  String   @default("/") @map("landing_path")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdBy User?            @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  signups   User[]
  events    PromotionEvent[]

  @@index([utmSource, utmMedium, utmCampaign])
  @@index([isActive, createdAt])
  @@map("promotions")
}

model PromotionEvent {
  id           String             @id @default(cuid())
  promotionId  String?            @map("promotion_id")
  eventType    PromotionEventType @map("event_type")
  utmSource    String?            @map("utm_source")
  utmMedium    String?            @map("utm_medium")
  utmCampaign  String?            @map("utm_campaign")
  utmContent   String?            @map("utm_content")
  utmTerm      String?            @map("utm_term")
  landingPath  String?            @map("landing_path")
  landingUrl   String?            @map("landing_url") @db.Text
  ip           String?
  userAgent    String?            @map("user_agent") @db.Text
  referrer     String?            @db.Text
  visitorKey   String?            @map("visitor_key")
  createdAt    DateTime           @default(now()) @map("created_at")

  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([promotionId, eventType, createdAt])
  @@index([visitorKey, promotionId, eventType, createdAt])
  @@map("promotion_events")
}
