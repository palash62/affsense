# Shared — local Docker MySQL (affsense-mysql publishes 3308→3306)
# Do not use a host-installed MySQL on :3306 for local dev.
DATABASE_URL="mysql://root@localhost:3308/affsense?connection_limit=10&pool_timeout=20"
# Shared by platform + tracking for internal APIs (lead submit, CPA sale notify).
# Send as header: X-Service-Token
INTERNAL_SERVICE_TOKEN="change-me-to-a-random-64-char-secret"

# Platform (affsense.com) — apps/platform/.env
AUTH_SECRET="your-secret-key-min-32-characters"
AUTH_URL="https://affsense.com"
APP_URL="https://affsense.com"
PLATFORM_URL="https://affsense.com"
TRACKING_URL="https://track.leadtb.com"
NEXT_PUBLIC_PLATFORM_URL="https://affsense.com"
NEXT_PUBLIC_TRACKING_URL="https://track.leadtb.com"
PORT=3000

# Tracking (track.leadtb.com) — apps/tracking/.env
TRACKING_URL="https://track.leadtb.com"
PLATFORM_URL="http://affsense.com"
NEXT_PUBLIC_TRACKING_URL="https://track.leadtb.com"
NEXT_PUBLIC_PLATFORM_URL="http://affsense.com"

# Optional fraud geo lookup for smart link rotation
FRAUD_IP_API_KEY=

# Email, payments, etc. (platform only)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
REDIS_URL="redis://localhost:6379"
SENTRY_DSN=""
# Mailgun HTTP API — used by marketing email. If MAILGUN_API_KEY is set, transactional
# email also goes through Mailgun first and SMTP below is only a fallback.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.affsense.com
MAILGUN_FROM="Affsense <noreply@mg.affsense.com>"
MAILGUN_API_BASE=https://api.mailgun.net
# HTTP webhook signing key (Mailgun → Sending → Webhooks). Required for delivery/bounce stats.
# Point domain webhooks (delivered, permanent_fail, complained) to:
#   https://affsense.com/api/v1/webhooks/mailgun
MAILGUN_WEBHOOK_SIGNING_KEY=
# Transactional email — SendGrid SMTP
# Leave MAILGUN_API_KEY empty, otherwise Mailgun is used first and SMTP is only a fallback.
# SMTP settings saved in the admin panel override these env vars.
# SMTP_PASS is a SendGrid API key with "Mail Send" permission; SMTP_USER is literally "apikey".
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
# Must be a verified sender or an authenticated domain in SendGrid (affsense.com)
SMTP_FROM="Affsense <noreply@affsense.com>"
ADMIN_ALERT_EMAIL=admin@affsense.com
SUPPORT_EMAIL=support@affsense.com
SUPPORT_TELEGRAM=yuvrajlushte
# Optional From for bulk support email
# SUPPORT_FROM_EMAIL=support@affsense.com
# EmailListVerify API key (apps.emaillistverify.com) — lead fraud email validation
FRAUD_EMAIL_API_KEY=
# Autoresponder integrations
INTEGRATION_ENCRYPTION_KEY=
# AWeber OAuth (Labs app). Register redirect:
#   http://localhost:3010/api/v1/advertiser/integrations/aweber/callback
#   https://affsense.com/api/v1/advertiser/integrations/aweber/callback
AWEBER_CLIENT_ID=
AWEBER_CLIENT_SECRET=
# Optional override (defaults to {PLATFORM_URL}/api/v1/advertiser/integrations/aweber/callback)
AWEBER_REDIRECT_URI=
# CPA Offer Marketplace — open to all advertisers by default when unset.
# Set a comma-separated email list to restrict (e.g. advertiser@cpl.local).
# Use * or empty for all advertisers.
CPA_OFFERS_ADVERTISER_ALLOWLIST=*
# Autoresponder — open to all advertisers by default when unset.
# Set a comma-separated email list to restrict (e.g. advertiser@cpl.local).
# Use * or empty for all advertisers.
AUTORESPONDER_ADVERTISER_ALLOWLIST=*
# Marketing email uses Mailgun (same keys as transactional above).
# Delivery/bounce/complaint: MAILGUN_WEBHOOK_SIGNING_KEY + Mailgun domain webhooks → /api/v1/webhooks/mailgun
